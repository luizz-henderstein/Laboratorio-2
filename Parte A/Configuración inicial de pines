int filas[8] = {2, 3, 4, 5, 6, 7, 8, 9};
int columnas[8] = {10, 11, 12, 13, A0, A1, A2, A3};

int pinPot = A4;
int velocidad = 100;

void apagarTodo() {
  for (int i = 0; i < 8; i++) {
    digitalWrite(filas[i], HIGH);
    digitalWrite(columnas[i], LOW);
  }
}

void setup() {
  for (int i = 0; i < 8; i++) {
    pinMode(filas[i], OUTPUT);
    pinMode(columnas[i], OUTPUT);
  }

  pinMode(pinPot, INPUT);

  apagarTodo();
}

void loop() {
}
