.include "m328pdef.inc"

.cseg
.org 0x0000
    rjmp RESET

RESET:

    ldi r16, HIGH(RAMEND)
    out SPH, r16

    ldi r16, LOW(RAMEND)
    out SPL, r16

    clr r1

    ldi r16, 0b11111110
    out DDRD, r16

    ldi r16, 0b00111111
    out DDRB, r16

    ldi r16, 0b00001111
    out DDRC, r16

    clr r16
    out PORTC, r16

    rcall apagarTodo

MAIN:
    rjmp MAIN

apagarTodo:

    in r16, PORTD
    ori r16, 0b11111100
    out PORTD, r16

    in r16, PORTB
    ori r16, 0b00000011
    andi r16, 0b11000011
    out PORTB, r16

    in r16, PORTC
    andi r16, 0b11110000
    out PORTC, r16

    ret
