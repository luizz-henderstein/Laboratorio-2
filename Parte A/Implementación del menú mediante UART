void apagarTodo() {
  for (int i = 0; i < 8; i++) {
    digitalWrite(filas[i], HIGH);
    digitalWrite(columnas[i], LOW);
  }
}

void mostrarImagen(byte imagen[8]) {
  for (int fila = 0; fila < 8; fila++) {
    apagarTodo();

    digitalWrite(filas[fila], LOW);

    for (int columna = 0; columna < 8; columna++) {
      if (bitRead(imagen[fila], 7 - columna)) {
        digitalWrite(columnas[columna], HIGH);
      }
    }

    delayMicroseconds(1000);
  }
}

void mostrarMenu() {
  Serial.println();
  Serial.println("MENU");
  Serial.println("1 - MICROS LO MEJOR");
  Serial.println("2 - Cara feliz");
  Serial.println("3 - Cara guino");
  Serial.println("4 - Corazon");
  Serial.println("5 - :3");
  Serial.println("6 - XD");
  Serial.println();
  Serial.println("Seleccione una opcion:");
}

void mostrarFigura(byte imagen[8]) {
  unsigned long inicio = millis();

  while (millis() - inicio < 3000) {
    mostrarImagen(imagen);
  }

  apagarTodo();
  mostrarMenu();
}

void setup() {
  for (int i = 0; i < 8; i++) {
    pinMode(filas[i], OUTPUT);
    pinMode(columnas[i], OUTPUT);
  }

  pinMode(pinPot, INPUT);

  apagarTodo();

  Serial.begin(9600);

  mostrarMenu();
}

void loop() {
  if (Serial.available() > 0) {
    char opcion = Serial.read();

    if (opcion == '2') {
      mostrarFigura(caraFeliz);
    }

    else if (opcion == '3') {
      mostrarFigura(caraGuino);
    }

    else if (opcion == '4') {
      mostrarFigura(corazon);
    }

    else if (opcion == '5') {
      mostrarFigura(cara3);
    }

    else if (opcion == '6') {
      mostrarFigura(xd);
    }
  }
}
