    rcall PARAR_MOTORES

    sbi PORTD, PD2
    rcall DELAY_SOLENOIDE
    cbi PORTD, PD2

    rcall DELAY_100MS

    ret

PEN_UP:

    rcall PARAR_MOTORES

    sbi PORTD, PD3
    rcall DELAY_SOLENOIDE
    cbi PORTD, PD3

    rcall DELAY_100MS

    ret

MOVER_TRAZO:

    in temp, PORTD
    andi temp, 0b00001111

    or temp, dir_mask
    out PORTD, temp

MOVER_TRAZO_LOOP:

    tst dur_pasos
    breq MOVER_TRAZO_FIN

    rcall DELAY_150MS

    dec dur_pasos
    rjmp MOVER_TRAZO_LOOP

MOVER_TRAZO_FIN:

    rcall PARAR_MOTORES
    ret

MOVER_TRAZO_HD:

    in temp, PORTD
    andi temp, 0b00001111

    or temp, dir_mask
    out PORTD, temp

MOVER_TRAZO_HD_LOOP:

    tst dur_pasos
    breq MOVER_TRAZO_HD_FIN

    rcall DELAY_40MS

    dec dur_pasos
    rjmp MOVER_TRAZO_HD_LOOP

MOVER_TRAZO_HD_FIN:

    ret

PARAR_MOTORES:

    in temp, PORTD
    andi temp, 0b00001111
    out PORTD, temp

    ret

ABAJO:
    ldi dir_mask, DIR_ABAJO
    rjmp MOVIMIENTO_NORMAL

ARRIBA:
    ldi dir_mask, DIR_ARRIBA
    rjmp MOVIMIENTO_NORMAL

IZQUIERDA:
    ldi dir_mask, DIR_IZQ
    rjmp MOVIMIENTO_NORMAL

DERECHA:
    ldi dir_mask, DIR_DER
    rjmp MOVIMIENTO_NORMAL

ABAJO_IZQUIERDA:
    ldi dir_mask, DIR_ABJ_IZQ
    rjmp MOVIMIENTO_NORMAL

ABAJO_DERECHA:
