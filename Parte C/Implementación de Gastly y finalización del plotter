    brne DELAY_100MS_LOOP

    ret

DELAY_40MS:

    ldi contador, 4

DELAY_40MS_LOOP:

    rcall DELAY_10MS

    dec contador
    brne DELAY_40MS_LOOP

    ret

DELAY_10MS:

    ldi r26, 208

DELAY_10MS_A:

    ldi r27, 255

DELAY_10MS_B:

    dec r27
    brne DELAY_10MS_B

    dec r26
    brne DELAY_10MS_A

    ret

DELAY_SOLENOIDE:

    ldi contador, 20

DELAY_SOLENOIDE_LOOP:

