PREPARAR_SECUENCIA:

    tst iniciado
    brne PREPARAR_FIN

    rcall IR_ZONA_DIBUJO

    ldi iniciado, 1

PREPARAR_FIN:
    ret

IR_ZONA_DIBUJO:

    rcall PEN_UP

    ldi data, 3
    rcall IZQUIERDA

    ldi data, 3
    rcall ABAJO

    ret

AVANZAR_SIGUIENTE:

    rcall PEN_UP

    ldi data, 3
    rcall IZQUIERDA

    inc avance

    ret

VOLVER_INICIO:

    rcall PEN_UP

VOLVER_INICIO_LOOP:

    tst avance
    breq VOLVER_INICIO_FIN

    ldi data, 3
    rcall DERECHA

    dec avance
    rjmp VOLVER_INICIO_LOOP

VOLVER_INICIO_FIN:
    ret

CMD_TODAS:

    rcall PREPARAR_SECUENCIA
    rcall VOLVER_INICIO

    rcall TRIANGULO
    rcall AVANZAR_SIGUIENTE

    rcall CIRCULO
    rcall AVANZAR_SIGUIENTE

    rcall CASA
    rcall AVANZAR_SIGUIENTE

    rcall GASTLY
    rcall AVANZAR_SIGUIENTE

    rcall AVANZAR_SIGUIENTE

