.equ DIR_ABAJO      = (1 << PD4)
.equ DIR_ARRIBA     = (1 << PD5)
.equ DIR_DER        = (1 << PD6)
.equ DIR_IZQ        = (1 << PD7)

.equ DIR_ARR_DER    = (1 << PD5) | (1 << PD6)
.equ DIR_ARR_IZQ    = (1 << PD5) | (1 << PD7)
.equ DIR_ABJ_DER    = (1 << PD4) | (1 << PD6)
.equ DIR_ABJ_IZQ    = (1 << PD4) | (1 << PD7)

.org 0x0000
    rjmp RESET

RESET:

    ldi temp, HIGH(RAMEND)
    out SPH, temp

    ldi temp, LOW(RAMEND)
    out SPL, temp

    ldi temp, 0b11111110
    out DDRD, temp

    clr temp
    out PORTD, temp

    clr avance
    clr iniciado

    rcall UART_INIT
    rcall PEN_UP
    rcall PRINT_MENU

MAIN:

    rcall UART_RX

    cpi data, 13
    breq MAIN

    cpi data, 10
    breq MAIN

    cpi data, '1'
    breq IR_TRIANGULO

    cpi data, '2'
    breq IR_CIRCULO

    cpi data, '3'
    breq IR_ESTRELLA

    cpi data, '4'
    breq IR_CASA

    cpi data, 'P'
    breq IR_GASTLY

    cpi data, 'p'
    breq IR_GASTLY

    cpi data, 'T'
    breq IR_TODAS

    cpi data, 't'
    breq IR_TODAS

    cpi data, 'R'
    breq IR_MENU

    cpi data, 'r'
    breq IR_MENU

    rcall PRINT_ERROR
    rjmp MAIN

