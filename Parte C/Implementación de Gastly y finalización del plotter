    rjmp MOVIMIENTO_NORMAL

ARRIBA_DERECHA:
    ldi dir_mask, DIR_ARR_DER
    rjmp MOVIMIENTO_NORMAL

MOVIMIENTO_NORMAL:

    in temp, PORTD
    andi temp, 0b00001111

    or temp, dir_mask
    out PORTD, temp

    mov segundos, data

MOVIMIENTO_NORMAL_LOOP:

    rcall DELAY_1S

    dec segundos
    brne MOVIMIENTO_NORMAL_LOOP

    rcall PARAR_MOTORES

    ret

DELAY_1S:

    ldi contador, 100

DELAY_1S_LOOP:

    rcall DELAY_10MS

    dec contador
    brne DELAY_1S_LOOP

    ret

DELAY_150MS:

    ldi contador, 15

DELAY_150MS_LOOP:

    rcall DELAY_10MS

    dec contador
    brne DELAY_150MS_LOOP

    ret

DELAY_100MS:

    ldi contador, 10

DELAY_100MS_LOOP:

