UART_INIT:

    clr temp
    sts UCSR0A, temp

    ldi temp, 0
    sts UBRR0H, temp

    ldi temp, 103
    sts UBRR0L, temp

    ldi temp, (1 << RXEN0) | (1 << TXEN0)
    sts UCSR0B, temp

    ldi temp, (1 << UCSZ01) | (1 << UCSZ00)
    sts UCSR0C, temp

    ret


UART_RX:

UART_RX_WAIT:

    lds temp, UCSR0A

    sbrs temp, RXC0
    rjmp UART_RX_WAIT

    lds data, UDR0

    ret


UART_TX:

UART_TX_WAIT:

    lds temp, UCSR0A

    sbrs temp, UDRE0
    rjmp UART_TX_WAIT

    sts UDR0, data

    ret


UART_PUTS:

    lpm data, Z+

    tst data
    breq UART_PUTS_FIN

    rcall UART_TX
    rjmp UART_PUTS

UART_PUTS_FIN:
    ret

PRINT_MENU:

    ldi ZL, LOW(2 * TXT_TITULO)
    ldi ZH, HIGH(2 * TXT_TITULO)
    rcall UART_PUTS

    ldi ZL, LOW(2 * TXT_1)
    ldi ZH, HIGH(2 * TXT_1)
    rcall UART_PUTS

    ldi ZL, LOW(2 * TXT_2)
    ldi ZH, HIGH(2 * TXT_2)
    rcall UART_PUTS

    ldi ZL, LOW(2 * TXT_3)
    ldi ZH, HIGH(2 * TXT_3)
    rcall UART_PUTS

    ldi ZL, LOW(2 * TXT_4)
    ldi ZH, HIGH(2 * TXT_4)
    rcall UART_PUTS

    ldi ZL, LOW(2 * TXT_P)
    ldi ZH, HIGH(2 * TXT_P)
    rcall UART_PUTS

    ldi ZL, LOW(2 * TXT_T)
    ldi ZH, HIGH(2 * TXT_T)
    rcall UART_PUTS

    ldi ZL, LOW(2 * TXT_R)
    ldi ZH, HIGH(2 * TXT_R)
    rcall UART_PUTS

    ldi ZL, LOW(2 * TXT_PROMPT)
    ldi ZH, HIGH(2 * TXT_PROMPT)
    rcall UART_PUTS

    ret
